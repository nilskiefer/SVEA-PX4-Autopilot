CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-m7"
CONFIG_BOARD_CONSTRAINED_FLASH=y
CONFIG_BOARD_NO_HELP=y
CONFIG_BOARD_EXTERNAL_METADATA=y
CONFIG_BOARD_LINKER_PREFIX="noboot"
CONFIG_BOARD_ROOT_PATH="/fs"
CONFIG_BOARD_PARAM_FILE="/fs/params"
CONFIG_NUM_MISSION_ITMES_SUPPORTED=1
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS0"
CONFIG_BOARD_SERIAL_RC="/dev/ttyS2"
CONFIG_COMMON_TELEMETRY=n
CONFIG_DRIVERS_CDCACM_AUTOSTART=n
CONFIG_DRIVERS_DSHOT=n
CONFIG_DRIVERS_GPS=n
CONFIG_DRIVERS_GPIO_PCAL6524=y
CONFIG_DRIVERS_LIGHTS_NEOPIXEL=n
CONFIG_DRIVERS_POWER_MONITOR_INA226=n
CONFIG_DRIVERS_POWER_MONITOR_SVEA_INA226=y
CONFIG_DRIVERS_POWER_MONITOR_SVEA_INA3221=y
CONFIG_DRIVERS_PCA9685_PWM_OUT=y
CONFIG_DRIVERS_PWM_OUT=y
CONFIG_DRIVERS_RC_INPUT=y
CONFIG_DRIVERS_SMART_BATTERY_BQ769X2=y
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42670P=n
CONFIG_DRIVERS_IMU_ST_ISM330DLC=n
CONFIG_DRIVERS_IMU_ST_LSM6DSOX=y
CONFIG_EXAMPLES_HELLO=n
CONFIG_EXAMPLES_BUTTON_LED_MIRROR=n
CONFIG_EXAMPLES_LED_BUS_WORKER=n
CONFIG_EXAMPLES_LED_PATTERN=n
CONFIG_EXAMPLES_NEOPIXEL_FX=n
CONFIG_MODULES_SVEA_POWER_GATE=y
CONFIG_MODULES_SVEA_PERIPHERAL_MCU=y
CONFIG_EXAMPLES_WORK_ITEM=n
CONFIG_MODULES_COMMANDER=y
CONFIG_MODULES_CONTROL_ALLOCATOR=y
CONFIG_MODULES_DATAMAN=y
CONFIG_MODULES_EVENTS=n
CONFIG_MODULES_EKF2=n
CONFIG_MODULES_LAND_DETECTOR=y
CONFIG_MODULES_LOAD_MON=y
CONFIG_MODULES_LOGGER=n
CONFIG_MODULES_MANUAL_CONTROL=y
CONFIG_MODULES_MAVLINK=y
CONFIG_MODULES_NAVIGATOR=y
CONFIG_MODULES_RC_UPDATE=y
CONFIG_MODULES_ROVER_ACKERMANN=y
CONFIG_MODULES_SENSORS=y
CONFIG_SYSTEMCMDS_BSONDUMP=y
CONFIG_SYSTEMCMDS_DMESG=y
CONFIG_SYSTEMCMDS_GPIO=y
CONFIG_SYSTEMCMDS_I2CDETECT=y
CONFIG_SYSTEMCMDS_LED_CONTROL=n
CONFIG_SYSTEMCMDS_MFT=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_PERF=n
CONFIG_SYSTEMCMDS_REBOOT=y
CONFIG_SYSTEMCMDS_TOP=n
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=y
CONFIG_SYSTEMCMDS_TUNE_CONTROL=n
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
