#!/bin/sh
#
# Clicker 4 STM32F7 specific board sensors init
#------------------------------------------------------------------------------

# SVEA powerboard with LSM6DSOXTR on mikroBUS I2C2 (0x6b).
if lsm6dsox -I -b 2 -a 0x6b -q start
then
	echo "lsm6dsox started on I2C bus 2 addr 0x6b"
else
	echo "ERROR: lsm6dsox not found on I2C bus 2 addr 0x6b"
	set STARTUP_TUNE 2
fi
