#!/bin/sh
#
# Clicker 4 STM32F7 specific board sensors init
#------------------------------------------------------------------------------

# SVEA rev2/rev3 with ISM330DLC on mikroBUS 3 (I2C2).
if ism330dlc -I -b 2 -a 0x6b -q start
then
	echo "ism330dlc started on I2C bus 2 addr 0x6b"
else
	echo "ERROR: ism330dlc not found on I2C bus 2 addr 0x6b"
	set STARTUP_TUNE 2
fi
