#!/bin/sh
#
# Clicker 4 STM32F7 board extras
#------------------------------------------------------------------------------

# Start actuator output driver.
if ! pwm_out status > /dev/null 2>&1
then
	pwm_out start
fi

# Configure PX4_UORB_TUNNEL power_monitor forwarding deterministically.
# -f allows registration before the uORB instance is advertised.
mavlink uorb_tunnel add -t power_monitor -i 0 -r 10 -f
mavlink uorb_tunnel add -t power_monitor -i 1 -r 10 -f

# WS281x/WS2815 on PC9 is available, but do not auto-start at boot.
# Start manually when needed:
#   neopixel start -n 1
