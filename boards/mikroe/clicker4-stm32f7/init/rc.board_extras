#!/bin/sh
#
# Clicker 4 STM32F7 board extras
#------------------------------------------------------------------------------

# Start actuator output driver.
if ! pwm_out status > /dev/null 2>&1
then
	pwm_out start
fi

# Default EKF global origin (Stockholm) for operation without GNSS.
# Format: commander set_ekf_origin <lat> <lon> <alt_amsl_m>
commander set_ekf_origin 59.35091170885886 18.068082193429863 0
