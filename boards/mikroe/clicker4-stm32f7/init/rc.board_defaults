#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# rev3 powerboard support in this first step does not wire system_power yet.
param set-default CBRK_SUPPLY_CHK 894281

# No onboard magnetometer is described for this target.
param set-default SYS_HAS_MAG 0

# uXRCE-DDS on RC UART (/dev/ttyS1).
param set-default UXRCE_DDS_CFG 300
param set-default SER_RC_BAUD 1500000
# Keep XRCE time sync enabled; startup no longer blocks waiting for convergence.
param set-default UXRCE_DDS_SYNCT 1
param set-default UXRCE_DDS_SYNCC 0
