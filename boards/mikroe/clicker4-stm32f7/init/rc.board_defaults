#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# rev3 powerboard support in this first step does not wire system_power yet.
param set-default CBRK_SUPPLY_CHK 894281

# No onboard magnetometer is described for this target.
param set-default SYS_HAS_MAG 0
param set-default SYS_HAS_BARO 0
param set-default COM_ARM_SDCARD 0

# Default to the SVEA TRX4 profile on fresh parameter storage.
param set-default SYS_AUTOSTART 51003

# Force sane first boot behavior even if params exist but airframe is unset.
if param compare SYS_AUTOSTART 0
then
	echo "Configuring default SVEA airframe (51003)"
	param set SYS_AUTOSTART 51003
	param set SYS_AUTOCONFIG 1
fi

# Keep RC/SBUS UART free from MAVLink traffic by default.
param set-default MAV_0_CONFIG 0
param set-default MAV_1_CONFIG 0
param set-default MAV_2_CONFIG 0

# RC receiver defaults: SBUS on the dedicated RC port (/dev/ttyS1).
param set-default RC_PORT_CONFIG 300
param set-default RC_INPUT_PROTO 2
param set-default RC_CHAN_CNT 7
param set-default COM_RC_IN_MODE 0

# RC channel mapping aligned with SVEA LLI Zephyr SBUS mapping:
# CH1 steer, CH2 throttle, CH4 diff toggle, CH5 mode/override, CH6 gear.
param set-default RC_MAP_ROLL 1
param set-default RC_MAP_THROTTLE 2
param set-default RC_MAP_AUX1 4
param set-default RC_MAP_FLTMODE 5
param set-default RC_MAP_GEAR_SW 6

# Minimal RC calibration baseline for rover use without QGC full radio wizard.
# Channels used: CH1 steer, CH2 throttle, CH5 mode/kill, CH6 gear.
param set-default RC1_MIN 1000
param set-default RC1_TRIM 1500
param set-default RC1_MAX 2000
param set-default RC2_MIN 1000
param set-default RC2_TRIM 1500
param set-default RC2_MAX 2000
param set-default RC5_MIN 1000
param set-default RC5_TRIM 1500
param set-default RC5_MAX 2000
param set-default RC6_MIN 1000
param set-default RC6_TRIM 1500
param set-default RC6_MAX 2000
param set-default RC7_MIN 1000
param set-default RC7_TRIM 1500
param set-default RC7_MAX 2000

# Map the 3-position CH5 switch to rover mode handover:
# low=Offboard (ROS/auto), mid=Manual (RC override), high=Manual + kill (mute).
# Duplicated slots make 3-position selection robust across RC calibration spread.
param set-default COM_FLTMODE1 7
param set-default COM_FLTMODE2 7
param set-default COM_FLTMODE3 0
param set-default COM_FLTMODE4 0
param set-default COM_FLTMODE5 0
param set-default COM_FLTMODE6 0

# CH5 high position engages kill switch. Kill drives disarmed PWM values.
param set-default RC_MAP_KILL_SW 5
param set-default RC_KILLSWITCH_TH 0.75

# CH7 momentary button arms/disarms without QGroundControl interaction.
param set-default RC_MAP_ARM_SW 7
param set-default COM_ARM_SWISBTN 1

# Mute behavior (kill/disarmed): force all active outputs to 0 duty.
param set-default PWM_MAIN_DIS1 0
param set-default PWM_MAIN_DIS2 0
param set-default PWM_MAIN_DIS3 0
param set-default PWM_MAIN_DIS4 0
param set-default PWM_MAIN_DIS5 0

# SVEA actuator function mapping (matches timer_config.cpp channel order).
param set-default PWM_MAIN_FUNC1 201  # Servo1: steering
param set-default PWM_MAIN_FUNC2 101  # Motor1: throttle
param set-default PWM_MAIN_FUNC3 202  # Servo2: gear
param set-default PWM_MAIN_FUNC4 203  # Servo3: front diff
param set-default PWM_MAIN_FUNC5 204  # Servo4: rear diff

# Keep all output timer groups at 100 Hz to match the Zephyr loop.
param set-default PWM_MAIN_TIM0 100
param set-default PWM_MAIN_TIM1 100
param set-default PWM_MAIN_TIM2 100
param set-default PWM_MAIN_TIM3 100

# Keep USB CDC auto-management enabled (cdcacm_autostart handles MAVLink on USB).
param set-default SYS_USB_AUTO 2
param set-default USB_MAV_MODE 2
